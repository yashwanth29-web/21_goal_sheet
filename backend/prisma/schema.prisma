generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Period {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum StatusType {
  PENDING
  COMPLETED
  PARTIALLY_COMPLETED
  MISSED
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  passwordHash  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  goals         Goal[]
  dailyStatuses DailyStatus[]
  cheatDays     CheatDay[]

  sentFriendships     Friendship[] @relation("SentFriendships")
  receivedFriendships Friendship[] @relation("ReceivedFriendships")
  notificationsReceived AppNotification[]
  notificationsSent     AppNotification[] @relation("NotificationSender")

  @@map("users")
}


enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Friendship {
  id                      String           @id @default(uuid())
  senderId                String
  sender                  User             @relation("SentFriendships", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId              String
  receiver                User             @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)
  status                  FriendshipStatus @default(PENDING)
  isAccountabilityPartner Boolean          @default(false)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@map("friendships")
}

model CheatDay {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  reason    String?  @default("Holiday / Cheat Day")
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("cheat_days")
}

model Goal {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  time        String        // e.g. "08:00 AM"
  period      Period        @default(MORNING)
  workGoal    String        // e.g. "DSA Practice"
  category    String?       @default("General")
  description String?
  date        String?       // Optional specific date YYYY-MM-DD or null for repeating routine
  order       Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  statuses    DailyStatus[]

  @@index([userId])
  @@index([userId, date])
  @@map("goals")
}

model DailyStatus {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  goal      Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date      String     // "YYYY-MM-DD"
  status    StatusType @default(PENDING)
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([goalId, date])
  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@map("daily_statuses")
}

model AppNotification {
  id        String   @id @default(uuid())
  userId    String   // The user receiving the notification
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  type      String   // 'FRIEND_REQUEST' | 'REQUEST_ACCEPTED' | 'GOAL_COMPLETED' | 'GOAL_MISSED' | 'PRODUCTIVE_WORK' | 'POKE' | 'STREAK_SWEEP'
  title     String
  message   String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@map("app_notifications")
}

